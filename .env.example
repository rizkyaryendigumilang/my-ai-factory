# PocketBase (self-hosted, SQLite). Collections are created by: node scripts/setup-pocketbase.mjs
# Superuser: ./pocketbase superuser upsert you@example.com 'strong-password'
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Server-only. Without these the app stores data in .data/factory.json instead.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Google Gemini API (server-only: do NOT add a NEXT_PUBLIC_ copy, it would leak into the browser)
GEMINI_API_KEY=
# Optional: primary model and comma-separated fallbacks (used on 404/503)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Optional switches
# FACTORY_PLAN=pro        # unlock Pro-only skills and unlimited projects
# FACTORY_MOCK=1          # force offline demo content (no AI calls)
# STORE_DRIVER=file       # file | pocketbase | (auto)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
